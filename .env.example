# Copy to .env and edit. .env is gitignored: never commit it.

# Port for the web page
PORT=8080

# Keep 127.0.0.1 unless you need to open the page from another device.
# If you change it, you MUST also set ALLOWED_HOSTS.
BIND_ADDRESS=127.0.0.1
# ALLOWED_HOSTS=192.168.1.50:8080

# Fixed access token (min 16 chars). Leave empty to get a new random one each run.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# Only if your relay's web interface asks for a username/password (http-cgi preset)
RELAY_HTTP_USER=
RELAY_HTTP_PASS=
